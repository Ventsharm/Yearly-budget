rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing production subscription rule: preserved verbatim.
    match /users/{userId}/yearlySubscriptions/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validReminder(r) {
      return r.keys().hasAll(['name', 'date', 'type', 'amount', 'done', 'updatedAt'])
        && r.name is string && r.name.size() > 0 && r.name.size() <= 140
        && r.date is string && r.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && r.type in ['cancel', 'payment', 'subscription'] && r.done is bool
        && (r.amount == null || (r.amount is number && r.amount >= 0 && r.amount <= 1000000000))
        && r.updatedAt is number;
    }
    match /users/{uid}/yearlyReminders/{reminderId} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && validReminder(request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'date', 'type', 'amount', 'done', 'createdAt', 'updatedAt'])
        && request.resource.data.createdAt is number;
      allow update: if owner(uid) && validReminder(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'date', 'type', 'amount', 'done', 'updatedAt']);
    }
    match /users/{uid}/yearlyPushTokens/{tokenId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && tokenId.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 20 && request.resource.data.token.size() <= 4096
        && request.resource.data.updatedAt is number;
    }
    // No client access to delivery claims. Only the Admin SDK may create them.
  }
}
